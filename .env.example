# Domain thật của site (dùng cho canonical, sitemap, OG, JSON-LD). Bắt buộc khi deploy.
NEXT_PUBLIC_SITE_URL=https://example.com
# Email hiện ở phần liên hệ + JSON-LD (để trống = ẩn)
NEXT_PUBLIC_CONTACT_EMAIL=

# Form liên hệ gửi đi đâu (miễn phí, bật cái nào cũng được, bật cả hai cũng được):
# 1) Telegram: tạo bot qua @BotFather lấy token; nhắn bot 1 tin rồi mở
#    https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 2) Webhook nhận JSON (vd Google Apps Script ghi vào Google Sheets)
CONTACT_WEBHOOK_URL=
# Không cấu hình gì -> ghi vào .data/contacts.jsonl trên máy chạy server.
